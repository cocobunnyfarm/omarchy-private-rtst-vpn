#!/usr/bin/env bash
# vpn-down: 해당 config의 모든 세션(connected/failed/awaiting 무관) 정리
# usage: vpn-down [config_name]   (생략하면 등록된 첫 프로파일)

set -uo pipefail
CONFIG="${1:-}"
# 프로파일 이름이 안 주어지면 openvpn3 에 등록된 첫 번째를 쓴다.
# 매직 상수를 두지 않기 위한 것 — vpn-ctl 도 같은 규칙을 쓴다.
discover_config() {
  openvpn3 configs-list 2>/dev/null | awk '
    /^-+$/                { next }
    /^Configuration Name/ { next }
    /^No configuration/   { next }
    NF == 0               { next }
    { print $1; exit }
  '
}

if [ -z "$CONFIG" ]; then
  CONFIG=$(discover_config)
  [ -n "$CONFIG" ] || { echo "[vpn-down] import 된 프로파일이 없습니다." >&2; exit 0; }
fi

paths=$(openvpn3 sessions-list 2>/dev/null | awk -v cfg="$CONFIG" '
  /^ *Path:/ { path=$2 }
  /^ *Config name:/ { if ($3==cfg) print path }
')

if [ -z "$paths" ]; then
  echo "[vpn-down] $CONFIG 세션 없음."
  exit 0
fi

while read -r p; do
  [ -z "$p" ] && continue
  echo "[vpn-down] disconnect: $p"
  openvpn3 session-manage --session-path "$p" --disconnect >/dev/null 2>&1 || true
done <<< "$paths"

echo "[vpn-down] 완료."
