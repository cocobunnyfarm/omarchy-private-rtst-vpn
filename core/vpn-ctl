#!/usr/bin/env bash
# vpn-ctl — VPN 상태·제어의 단일 진입점. UI 레이어가 이것만 호출한다.
#
# Omarchy 에 의존하지 않는다. 평범한 CLI 이므로 우분투·서버에서도 그대로 쓴다.
#
# usage:
#   vpn-ctl status [--json]      상태 조회. 항상 종료코드 0, 상태는 출력으로
#   vpn-ctl up [config]          연결 (SSO URL 브라우저 오픈)
#   vpn-ctl down [config]        끊기 + 좀비 세션 정리
#   vpn-ctl import <file>        .ovpn 을 보관하고 활성으로 지정 + openvpn3 에 import
#                                프로파일 이름은 파일명에서 유도된다
#   vpn-ctl profiles [--json]    보관된 .ovpn 목록 (활성 표시)
#   vpn-ctl use <name>           활성 프로파일 전환
#   vpn-ctl forget <name>        보관본 + openvpn3 프로파일 삭제
#   vpn-ctl clear-error          마지막 실패 기록을 지운다 (UI 의 "확인" 버튼)
#   vpn-ctl auth-url             현재 세션의 SSO 인증 URL 출력 (복사해서 원하는
#                                브라우저에서 열면 그 세션이 연결된다)
#   vpn-ctl ensure-config        프로파일이 없으면 보관된 .ovpn 으로 복구
#                                (status/up 이 자동으로 하므로 보통 직접 쓸 일 없다)
#   vpn-ctl backend-install-cmd  백엔드 설치 명령 문자열을 출력 (실행하지 않음)
#   vpn-ctl -h
#
# 상태 모델 (status --json 의 .state):
#   missing-backend  openvpn3 미설치
#   missing-config   사용자가 .ovpn 을 등록한 적이 없다 — 파일을 골라야 한다
#   backend-busy     openvpn3 서비스 응답 없음 (부팅 직후 등). 연결 상태는 미확정
#   disconnected     준비됐고 미연결 (직전 시도가 실패했으면 .last_error 가 붙는다)
#   connecting       세션은 있고 서버와 협상 중 (SSO URL 을 아직 못 받음 / 재연결 중)
#                    .since = 세션 시작 epoch, .stalled = 너무 오래 걸림
#   authenticating   SSO 인증 대기
#   connected        연결됨
#   error            그 외
#
# 등록 여부의 판단 근거는 **우리 보관본**($DATA_DIR/*.ovpn)이다. openvpn3 의
# configs-list 가 아니다 — 그건 D-Bus 서비스 상태에 따라 비어 보일 수 있고,
# 우리가 넣지 않은 프로파일이 들어 있을 수도 있다. 사용자가 이 플러그인으로
# 고른 파일만이 "등록했다" 의 근거다. openvpn3 쪽 등록은 필요할 때 우리가
# 보관본으로 다시 만들어 주면 되는 파생 상태다.
#
# 검증 상태 (openvpn3 v27.1 실기기):
#   missing-backend / missing-config / disconnected / authenticating 검증됨.
#   import / use / forget / profiles, 활성 승계, 마지막 삭제 → missing-config
#   전이까지 실제로 돌려 확인했다.
#   connected 는 SSO 로그인을 끝까지 하지 않아 미검증 —
#   sessions-list 의 'Client connected' 문자열 대조에 의존한다.

set -uo pipefail

DATA_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rtst-vpn"

# ── 유틸 ────────────────────────────────────────────────────────────────
json_escape() {
  # 따옴표·백슬래시·개행만 처리하면 우리 문자열에는 충분하다
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' '
}

emit_json() {
  # emit_json <state> <detail> <config> <actionable> <profiles-json> [extra]
  # extra: 이미 JSON 으로 만든 추가 필드들 (',"since":…' 처럼 콤마로 시작)
  printf '{"state":"%s","detail":"%s","config":"%s","actionable":%s,"profiles":%s%s}\n' \
    "$(json_escape "$1")" "$(json_escape "$2")" "$(json_escape "$3")" \
    "$([ -n "${4:-}" ] && printf '"%s"' "$(json_escape "$4")" || printf 'null')" \
    "${5:-[]}" "${6:-}"
}

have_backend() { command -v openvpn3 >/dev/null 2>&1; }

backend_install_cmd() {
  # Arch/Omarchy: openvpn3 는 공식 저장소에 없고 AUR 에 있다.
  if command -v omarchy >/dev/null 2>&1; then
    printf 'omarchy pkg aur add openvpn3\n'
  elif command -v yay >/dev/null 2>&1; then
    printf 'yay -S --needed openvpn3\n'
  elif command -v apt >/dev/null 2>&1; then
    printf '# Debian/Ubuntu: openvpn3 저장소 등록이 필요하다. docs/ 참조\n'
  else
    printf '# openvpn3 를 배포판 방식으로 설치할 것\n'
  fi
}

# import 된 프로파일 이름을 전부 나열한다.
# configs-list 출력 형식 (v27.1 실측):
#   Configuration Name                     Last used
#   ------------------------------------------------
#   hell                                   2026-08-27 15:25:31
#   ------------------------------------------------
# openvpn3 configs-list 원문을 캐시한다 (한 번만 호출).
CONFIGS_RAW=""
CONFIGS_OK=0
configs_load() {
  [ -n "$CONFIGS_RAW" ] && return 0
  CONFIGS_RAW="$(openvpn3 configs-list 2>/dev/null)"
  # 표 헤더가 있으면 openvpn3 가 실제로 응답한 것이다. 없으면 조회 실패로 본다 —
  # configmgr 은 D-Bus on-demand 서비스라 부팅 직후엔 활성화 전일 수 있다.
  # "빈 목록" 과 "물어볼 수 없었음" 을 절대 같게 취급하지 않는다.
  if printf '%s' "$CONFIGS_RAW" | grep -q 'Configuration Name'; then
    CONFIGS_OK=1
  else
    CONFIGS_OK=0
  fi
}

backend_ready() { configs_load; [ "$CONFIGS_OK" -eq 1 ]; }

configs_list_names() {
  configs_load
  [ "$CONFIGS_OK" -eq 1 ] || return 0
  printf '%s\n' "$CONFIGS_RAW" | awk '
    /^-+$/                    { next }
    /^Configuration Name/     { next }
    NF == 0                   { next }
    { print $1 }
  '
}

# ── 보관소 ($DATA_DIR) ──────────────────────────────────────────────────
# 사용자가 고른 .ovpn 원본을 여기에 보관한다. 이게 "등록했다" 의 유일한 근거다.
#
#   $DATA_DIR/<name>.ovpn   보관된 프로파일 (여러 개 가능)
#   $DATA_DIR/active        활성 프로파일 이름 한 줄
#
# openvpn3 쪽 등록은 여기서 언제든 다시 만들 수 있는 파생 상태로 취급한다.
ACTIVE_FILE="$DATA_DIR/active"

profile_name_of() {
  # /path/to/hansulee-hell.ovpn -> hansulee-hell
  local b; b="$(basename "$1")"
  printf '%s\n' "${b%.*}"
}

# 보관된 파일 경로를 최신순으로 나열한다.
stored_paths() {
  ls -1t "$DATA_DIR"/*.ovpn "$DATA_DIR"/*.conf 2>/dev/null
}

stored_names() {
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    profile_name_of "$p"
  done <<EOF
$(stored_paths)
EOF
}

stored_path_of() {
  local want="$1" p
  [ -n "$want" ] || return 0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ "$(profile_name_of "$p")" = "$want" ] && { printf '%s\n' "$p"; return 0; }
  done <<EOF
$(stored_paths)
EOF
  return 0
}

set_active() {
  mkdir -p "$DATA_DIR"; chmod 700 "$DATA_DIR"
  printf '%s\n' "$1" > "$ACTIVE_FILE"
  chmod 600 "$ACTIVE_FILE"
}

# 활성 프로파일 이름. active 파일이 가리키는 게 실제로 보관돼 있어야 인정한다.
# 없거나 어긋나면 가장 최근에 넣은 것으로 승계한다 — active 파일이 생기기
# 전에 import 한 사용자도 그대로 동작해야 하므로.
active_name() {
  local name
  name="$(head -1 "$ACTIVE_FILE" 2>/dev/null)"
  if [ -n "$name" ] && [ -n "$(stored_path_of "$name")" ]; then
    printf '%s\n' "$name"; return 0
  fi
  stored_names | head -1
}

# 이름이 <cfg> 인 openvpn3 프로파일의 D-Bus 경로를 전부 나열한다.
# 이름으로 지우면(config-remove --config) 중복이 있을 때 openvpn3 가 어느 걸
# 지울지 몰라 실패한다 — 하필 중복을 치워야 하는 바로 그 순간에. 그래서 경로로 지운다.
# --json 형식 (v27.1 실측):  "/net/openvpn/v3/configuration/…" : { … "name" : "hell", … }
backend_config_paths() {
  local cfg="$1"
  openvpn3 configs-list --json 2>/dev/null | awk -v cfg="$cfg" '
    match($0, /"\/net\/openvpn\/v3\/configuration\/[^"]+"/) {
      p = substr($0, RSTART + 1, RLENGTH - 2); next
    }
    /^[ \t]*"name"[ \t]*:/ {
      v = $0
      sub(/^[^:]*:[ \t]*"/, "", v); sub(/",?[ \t]*$/, "", v)
      if (v == cfg && p != "") print p
    }
  '
}

# 같은 이름의 openvpn3 프로파일을 전부 지운다. openvpn3 는 이름 중복을 막지 않아서,
# 이걸 안 하면 다시 넣을 때마다 쌓이고 session-start --config 이름 이 실패한다.
remove_backend_config() {
  local cfg="$1" p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    openvpn3 config-remove --path "$p" --force >/dev/null 2>&1 \
      || echo "vpn-ctl: openvpn3 프로파일 삭제 실패: $p" >&2
  done <<EOF
$(backend_config_paths "$cfg")
EOF
  CONFIGS_RAW=""; CONFIGS_OK=0
}

# openvpn3 프로파일을 바꾸는 일(지우고 다시 넣기)은 한 번에 하나만.
# 위젯은 status 를 주기적으로 부르고 status 는 사라진 프로파일을 복구한다.
# 같은 순간 사용자가 연결을 누르면 up 도 복구를 시도한다. 잠금 없이는 둘 다
# "없음" 을 보고 각자 import 해서 같은 이름이 두 개 생긴다. (실제로 겪었다:
# 같은 초에 import 된 hansulee-hell 두 개 → session-start 실패.)
#
# 서브셸 안에서 잠그므로 잠금은 이 호출이 끝나면 풀린다 — up 이 vpn-up 으로
# exec 될 때까지 쥐고 있지 않는다. 대신 서브셸에서 갱신한 목록 캐시는 부모로
# 돌아오지 않으므로 여기서 버린다. 중첩 호출 금지 (같은 프로세스가 다시 열면 교착).
LOCK_FILE="${XDG_RUNTIME_DIR:-/tmp}/rtst-vpn-ctl.$(id -u).lock"
with_backend_lock() {
  local rc
  (
    flock -w 30 9 || { echo "vpn-ctl: openvpn3 프로파일 잠금 대기 초과" >&2; exit 1; }
    CONFIGS_RAW=""; CONFIGS_OK=0   # 기다리는 동안 다른 쪽이 바꿨을 수 있다
    "$@"
  ) 9>"$LOCK_FILE"
  rc=$?
  CONFIGS_RAW=""; CONFIGS_OK=0
  return "$rc"
}

# 보관본을 openvpn3 에 등록한다. --persistent: 재부팅 후에도 유지.
# 잠금 안에서만 부른다 — import_to_backend 를 쓸 것.
_import_to_backend() {
  local src="$1" cfg="$2"
  remove_backend_config "$cfg"
  openvpn3 config-import --config "$src" --persistent --name "$cfg" >/dev/null || return 1
  CONFIGS_RAW=""; CONFIGS_OK=0
}
import_to_backend() { with_backend_lock _import_to_backend "$@"; }

# 잠금 안에서 다시 확인하고, 그래도 없거나 중복이면 복구한다.
_ensure_config_locked() {
  local cfg="$1" src="$2" n
  config_imported "$cfg" && return 0
  n="$(config_count "$cfg")"
  if [ "$n" -gt 1 ]; then
    echo "vpn-ctl: openvpn3 에 '$cfg' 가 ${n}개 중복돼 있어 하나로 정리합니다" >&2
  else
    echo "vpn-ctl: openvpn3 에 프로파일이 없어 보관본으로 복구합니다: $(basename "$src")" >&2
  fi
  _import_to_backend "$src" "$cfg"
}

# 활성 프로파일이 openvpn3 에 정확히 하나 등록돼 있도록 보장하고 그 이름을 출력한다.
# 등록된 .ovpn 자체가 없으면 실패한다 (= missing-config).
ensure_config() {
  local cfg; cfg="$(active_name)"
  [ -n "$cfg" ] || return 1

  backend_ready || { echo "vpn-ctl: openvpn3 응답 없음 (잠시 후 재시도)" >&2; return 1; }
  config_imported "$cfg" && { printf '%s\n' "$cfg"; return 0; }

  local src; src="$(stored_path_of "$cfg")"
  [ -n "$src" ] || return 1
  with_backend_lock _ensure_config_locked "$cfg" "$src" || return 1
  printf '%s\n' "$cfg"
}

# 보관 목록을 JSON 배열로. UI 가 프로파일 관리 화면을 그리는 근거.
profiles_json() {
  local active; active="$(active_name)"
  local out="[" first=1 p n
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    n="$(profile_name_of "$p")"
    [ "$first" -eq 1 ] || out="$out,"
    first=0
    out="$out{\"name\":\"$(json_escape "$n")\",\"file\":\"$(json_escape "$(basename "$p")")\""
    if [ "$n" = "$active" ]; then out="$out,\"active\":true}"; else out="$out,\"active\":false}"; fi
  done <<EOF
$(stored_paths)
EOF
  printf '%s]\n' "$out"
}

config_count() {
  local cfg="$1"
  [ -n "$cfg" ] || { echo 0; return 0; }
  configs_list_names | grep -cxF "$cfg"
}

# "쓸 수 있게 등록됨" = 그 이름이 **정확히 하나**. 두 개 이상이면 openvpn3 가
# 이름으로 고르지 못해 session-start 가 "More than one configuration profile
# was found" 로 실패한다 — 없는 것과 똑같이 복구 대상이다.
config_imported() {
  [ "$(config_count "$1")" -eq 1 ]
}

# 살아 있는 세션 전부를 "<config><TAB><status><TAB><created><TAB><path>" 로 나열한다.
# sessions-list 출력 형식 (v27.1 실측):
#           Path: /net/openvpn/v3/sessions/...
#        Created: 2026-11-27 15:01:44                       PID: 249099
#    Config name: <name>
#         Status: <text>
sessions_all() {
  openvpn3 sessions-list 2>/dev/null | awk '
    /^ *Path:/        { path=$2 }
    /^ *Created:/     { created=$2 " " $3 }
    /^ *Config name:/ { name=$3 }
    /^ *Status:/ {
      if (name != "") {
        s=$0; sub(/^ *Status: */, "", s)
        print name "\t" s "\t" created "\t" path
        name=""; created=""; path=""
      }
    }
  '
}

session_status_text() {
  local cfg="$1"
  [ -n "$cfg" ] || return 0
  sessions_all | awk -F'\t' -v c="$cfg" '$1==c { print $2; exit }'
}

# 끊을 대상. 활성 프로파일에 세션이 있으면 그것, 없으면 아무 세션이나.
# 활성 이름만 보고 끊으면 다른 이름으로 남은 세션을 영원히 못 치운다.
session_config_or_active() {
  local a; a="$(active_name)"
  if [ -n "$a" ] && [ -n "$(session_status_text "$a")" ]; then
    printf '%s\n' "$a"; return 0
  fi
  local o; o="$(sessions_all | head -1 | cut -f1)"
  if [ -n "$o" ]; then printf '%s\n' "$o"; return 0; fi
  printf '%s\n' "$a"
}

# 이름이 <cfg> 인 세션의 한 필드 (3 = created, 4 = path)
session_field() {
  local cfg="$1" n="$2"
  [ -n "$cfg" ] || return 0
  sessions_all | awk -F'\t' -v c="$cfg" -v n="$n" '$1==c { print $n; exit }'
}

# ── 세션 감시 (실패 원인 기록) ──────────────────────────────────────────
# 실패한 세션은 openvpn3 에서 **흔적 없이 사라진다.** status 가 지금 상태만
# 보면 "인증 60초 대기 → 실패 → 세션 소멸" 이 그냥 "세션 없음" 으로 보이고,
# 사용자는 버튼이 안 먹는 줄 안다. (실제로 겪었다: 서버 인증 연동이 죽어
# 모두가 연결 실패했는데 위젯은 '연결 안 됨' 만 보여줬다.)
#
# 그래서 세션마다 `openvpn3 log` 를 백그라운드로 붙여 그 세션의 로그를 파일로
# 남긴다. 세션이 끝나면 openvpn3 log 도 스스로 끝난다 ("Session closed").
# status 는 세션이 없을 때 이 파일을 읽어 마지막 실패 원인을 알려준다.
#
#   $STATE_DIR/watch.lock    감시자가 살아 있는 동안 쥐고 있는 잠금
#   $STATE_DIR/watch.target  감시 대상 (세션 경로 또는 프로파일 이름)
#   $STATE_DIR/watch.pid     감시자 pid
#   $STATE_DIR/session.log   그 세션의 openvpn3 로그
#   $STATE_DIR/auth-seen     이 세션에서 SSO URL 이 나온 적이 있음
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/rtst-vpn"
WATCH_LOG="$STATE_DIR/session.log"

state_dir() { mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"; }

watcher_alive() {
  [ -e "$STATE_DIR/watch.lock" ] || return 1
  ! flock -n "$STATE_DIR/watch.lock" true 2>/dev/null
}

# 감시자 본체. 반드시 setsid 로 떼어서 부른다 (spawn_watcher).
#   _watch --config <name>        세션이 시작되길 기다렸다가 붙는다 (up 직전)
#   _watch --session-path <path>  이미 있는 세션에 붙는다 (status 가 뒤늦게)
cmd_watch() {
  local mode="$1" target="$2"
  state_dir || exit 1
  exec 8>"$STATE_DIR/watch.lock"
  # 이전 세션의 감시자는 그 세션이 끝나면 곧 풀어 준다
  flock -w 15 8 || exit 0

  if [ "$mode" = "--session-path" ]; then
    # 기다리는 사이 세션이 끝났으면 붙지 않는다 — 여기서 로그를 비우면
    # 방금 끝난 세션의 실패 기록을 지우게 된다.
    openvpn3 sessions-list 2>/dev/null | grep -qF "$target" || exit 0
  fi

  # 같은 대상에 다시 붙는 거면 (감시자가 죽었다 살아난 경우) 이어 쓴다.
  if [ "$(cat "$STATE_DIR/watch.target" 2>/dev/null)" != "$target" ]; then
    : > "$WATCH_LOG"
    rm -f "$STATE_DIR/auth-seen"
  fi
  chmod 600 "$WATCH_LOG" 2>/dev/null
  printf '%s\n' "$target" > "$STATE_DIR/watch.target"
  printf '%s\n' "$$"      > "$STATE_DIR/watch.pid"

  # exec 해도 fd 8(잠금)은 openvpn3 log 프로세스가 물려받아 끝까지 쥔다.
  exec openvpn3 log "$mode" "$target" >> "$WATCH_LOG" 2>&1
}

spawn_watcher() {
  state_dir || return 0
  setsid -f "$here/vpn-ctl" _watch "$@" </dev/null >/dev/null 2>&1 || true
}

# 아직 어떤 세션에도 붙지 못하고 기다리기만 하는 감시자를 치운다
# (up 이 세션을 못 만들고 끝난 경우).
kill_idle_watcher() {
  watcher_alive || return 0
  grep -q '^Attaching' "$WATCH_LOG" 2>/dev/null && return 0
  local pid; pid="$(cat "$STATE_DIR/watch.pid" 2>/dev/null)"
  [ -n "$pid" ] && kill "$pid" 2>/dev/null
  return 0
}

# 사용자가 일부러 끊은 건 실패가 아니다. 기록을 지운다.
# 감시자는 열린 fd 로 지워진 파일에 마저 쓰고 끝나므로 건드리지 않아도 된다.
clear_watch_record() {
  rm -f "$WATCH_LOG" "$STATE_DIR/auth-seen" "$STATE_DIR/watch.target"
}

# 세션 로그를 읽어 실패 원인을
#   "<reason>\t<at>\t<summary>\t<advice>\t<hint>\t<raw>"
# 한 줄로 낸다. summary/advice 는 UI 가 바로 보여줄 짧은 말, hint 는 자세한 설명.
# 실패가 아니면(정상 종료 등) 아무것도 내지 않는다.
#
# reason:
#   server-auth      SSO URL 이 한 번도 안 왔는데 인증 실패 — 서버 인증 연동 문제
#   auth-failed      URL 은 왔는데 인증 실패 — 로그인 거부 / 시간 초과
#   session-expired  서버가 세션(재연결)을 만료 처리
#   unreachable      서버에 닿지 않음 (타임아웃, DNS, TLS 협상 실패)
#   other            그 밖의 치명적 오류
#
# 실측 (openvpn3 v27.1, 2026-11-27 서버 인증 장애 때):
#   [STATUS] Connection, Client authentication failed: Authentication failed
#   Client **!! FATAL !!**: [SESSION_EXPIRED]
#   [STATUS] Session, URL authentication: https://…   (URL 이 온 경우)
classify_failure() {
  local log="$1" line reason summary advice hint auth_seen=0
  [ -s "$log" ] || return 0

  if [ -e "$STATE_DIR/auth-seen" ] \
     || grep -iE 'web.?(based )?auth|authentication required|auth(entication)? url|url auth|pending' "$log" \
        | grep -viq 'failed'; then
    auth_seen=1
  fi

  if line="$(grep -m1 'SESSION_EXPIRED' "$log")"; then
    reason="session-expired"
    summary="서버가 연결을 끊음"; advice="다시 연결하세요"
    if grep -qiE 'Client connected|Reconnecting' "$log"; then
      hint="연결이 끊긴 뒤 재연결을 서버가 거부했습니다 (세션 만료). 다시 연결해 로그인하세요. 다들 같이 끊겼다면 서버 쪽 문제입니다."
    else
      hint="서버가 세션을 만료 처리했습니다. 다시 연결해 로그인하세요."
    fi
  elif line="$(grep -m1 -iE 'authentication failed|AUTH_FAILED' "$log")"; then
    if [ "$auth_seen" -eq 1 ]; then
      reason="auth-failed"
      summary="로그인 실패"; advice="다시 연결해 보세요"
      hint="로그인이 거부됐거나 제한 시간 안에 끝나지 않았습니다. 다시 연결해 보세요."
    else
      reason="server-auth"
      summary="VPN 서버 인증 장애"; advice="내 PC 문제 아님 · 관리자에게 알려 주세요"
      hint="서버가 로그인 페이지를 주지 않고 인증을 실패 처리했습니다. VPN 서버(인증 연동) 쪽 문제일 가능성이 큽니다 — 다들 안 되면 관리자에게 알려 주세요."
    fi
  elif line="$(grep -m1 -iE 'timeout|handshake|resolve|unreachable|network is|transport error|connection refused|NETWORK_' "$log")"; then
    reason="unreachable"
    summary="VPN 서버에 닿지 않음"; advice="네트워크를 확인하세요"
    hint="VPN 서버에 닿지 않습니다. 네트워크를 확인하세요. 다들 안 되면 서버가 내려갔을 수 있습니다."
  elif line="$(grep -m1 -E 'FATAL|CRITICAL|[Ff]ailed' "$log")"; then
    reason="other"
    summary="연결 실패"; advice="다시 연결해 보세요"
    hint="연결에 실패했습니다."
  else
    return 0
  fi

  # 로그 줄 형식: "2026-11-27 15:05:44  [STATUS] Connection, …"
  local at raw
  at="$(printf '%s' "$line" | grep -oE '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9:]{8}')"
  raw="$(printf '%s' "$line" | sed -E 's/^[0-9-]+ [0-9:]+ +//')"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$reason" "$at" "$summary" "$advice" "$hint" "$raw"
}

last_error_json() {
  local r; r="$(classify_failure "$WATCH_LOG")"
  [ -n "$r" ] || return 0
  local reason at summary advice hint raw
  IFS=$'\t' read -r reason at summary advice hint raw <<<"$r"
  printf ',"last_error":{"reason":"%s","at":"%s","summary":"%s","advice":"%s","hint":"%s","raw":"%s"}' \
    "$(json_escape "$reason")" "$(json_escape "$at")" \
    "$(json_escape "$summary")" "$(json_escape "$advice")" \
    "$(json_escape "$hint")" "$(json_escape "$raw")"
}

# SSO URL 이 이만큼 지나도 안 오면 "서버가 응답하지 않는다" 로 본다.
# 정상이면 몇 초 안에 온다. 서버는 60초에 인증 실패로 끊는다.
STALL_SEC=20

# ── auth-url ────────────────────────────────────────────────────────────
# 현재 세션의 SSO 인증 URL 을 출력한다.
#
# openvpn3 는 이 URL 을 XDG Desktop Portal 로 넘겨 **시스템 기본 브라우저**에
# 띄운다. 그걸 바꿀 방법이 없다 ($BROWSER 무시, xdg-open 미호출, 끄는 옵션 없음).
# 다른 브라우저에서 인증하려면 이 URL 을 복사해 직접 열면 된다 —
# URL 은 세션에 묶여 있으므로 어디서 로그인하든 그 세션이 연결된다.
cmd_auth_url() {
  have_backend || { echo "vpn-ctl auth-url: openvpn3 가 없습니다" >&2; return 1; }
  local url
  url=$(openvpn3 session-auth 2>/dev/null \
        | awk -F': ' '/^ *Auth URL:/ {sub(/^ +/, "", $2); print $2; exit}')
  [ -n "$url" ] || { echo "vpn-ctl auth-url: 인증 대기 중인 세션이 없습니다" >&2; return 1; }
  printf '%s\n' "$url"
}

# ── status ──────────────────────────────────────────────────────────────
cmd_status() {
  local want="$1" as_json="$2"
  local state detail actionable="" cfg="" extra=""

  if ! have_backend; then
    state="missing-backend"
    detail="openvpn3 가 설치되지 않았습니다"
    actionable="$(backend_install_cmd)"
    emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json"
    return 0
  fi

  # 등록 여부를 **먼저** 본다. 근거가 우리 보관소이므로 openvpn3 가 응답하지
  # 않아도 확정할 수 있다. "아직 아무것도 고르지 않았다" 는 백엔드 사정과
  # 무관한 사실이고, UI 는 이걸 알아야 연결 버튼을 잠글 수 있다.
  cfg="$(active_name)"
  if [ -n "$want" ] && [ -n "$(stored_path_of "$want")" ]; then cfg="$want"; fi

  if [ -z "$cfg" ]; then
    state="missing-config"
    detail="등록된 .ovpn 이 없습니다"
    emit_or_print "$state" "$detail" "" "$actionable" "$as_json"
    return 0
  fi

  if ! backend_ready; then
    # openvpn3 에 물어보지 못한 상태. 연결 여부는 모르지만 프로파일은 있다.
    state="backend-busy"
    detail="openvpn3 서비스 응답 대기 중"
    emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json"
    return 0
  fi

  # openvpn3 쪽 등록이 사라졌으면 **조용히 복원한다.**
  # 사용자는 이미 파일을 골랐다. 그 결정을 다시 묻지 않는다 — openvpn3
  # 프로파일은 D-Bus 서비스 상태에 따라 사라질 수 있지만, 우리가 원본을
  # 들고 있으므로 그건 사용자가 알 필요 없는 내부 사정이다.
  if ! config_imported "$cfg"; then
    ensure_config >/dev/null 2>&1
    CONFIGS_RAW=""; CONFIGS_OK=0   # 다시 넣었으니 목록 캐시를 버린다
  fi

  if ! config_imported "$cfg"; then
    state="error"
    detail="프로파일 '$cfg' 을 openvpn3 에 등록할 수 없습니다"
  else
    local st other
    st="$(session_status_text "$cfg")"

    # 활성 프로파일에 세션이 없어도 **다른 이름**으로 살아 있는 세션이 있으면
    # "끊김" 이라고 말하면 안 된다 — 실제로는 연결/인증 중이다. 그대로 두면
    # 위젯이 연결 버튼을 내주고, 사용자는 눌러도 아무 일이 없는 것처럼 본다.
    # 이때 config 는 세션의 실제 이름으로 바꿔 보고한다 — 끊을 대상이 그거니까.
    if [ -z "$st" ]; then
      other="$(sessions_all | head -1)"
      if [ -n "$other" ]; then
        cfg="$(printf '%s' "$other" | cut -f1)"
        st="$(printf '%s' "$other" | cut -f2)"
      fi
    fi

    if [ -z "$st" ]; then
      state="disconnected"
      detail="세션 없음"
      # 세션이 사라졌다 = 끝났다. 실패로 끝났으면 그 원인을 붙인다.
      extra="$(last_error_json)"
    else
      # 세션이 있는데 감시자가 없으면 붙인다 (이 기능 이전에 시작된 세션,
      # 플러그인 밖에서 시작된 세션 등). 그래야 나중에 끊겨도 원인이 남는다.
      local spath; spath="$(session_field "$cfg" 4)"
      if [ -n "$spath" ] && ! watcher_alive; then
        spawn_watcher --session-path "$spath"
      fi

      if printf '%s' "$st" | grep -q 'Client connected'; then
        state="connected"
        detail="$st"
      elif printf '%s' "$st" | grep -qiE 'fail|error|disconnect|exit'; then
        # "Client authentication failed" 도 auth 를 포함하므로 먼저 거른다
        state="error"
        detail="$st"
      elif printf '%s' "$st" | grep -qiE 'auth|web based|url'; then
        state="authenticating"
        detail="$st"
        state_dir && : > "$STATE_DIR/auth-seen"
      elif printf '%s' "$st" | grep -qiE 'connecting|reconnect|wait|resolv|config'; then
        state="connecting"
        local created since=0 now elapsed stalled=false
        created="$(session_field "$cfg" 3)"
        [ -n "$created" ] && since="$(date -d "$created" +%s 2>/dev/null || echo 0)"
        now="$(date +%s)"
        if [ "$since" -gt 0 ]; then
          elapsed=$((now - since))
          if [ "$elapsed" -ge "$STALL_SEC" ]; then
            stalled=true
            detail="${elapsed}초째 로그인 페이지 대기 중"
          else
            detail="서버와 연결 중… (${elapsed}초)"
          fi
        else
          detail="$st"
        fi
        extra=",\"since\":$since,\"stalled\":$stalled"
      else
        state="error"
        detail="$st"
      fi
    fi
  fi

  emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json" "$extra"
  return 0
}

emit_or_print() {
  local state="$1" detail="$2" cfg="$3" actionable="$4" as_json="$5" extra="${6:-}"
  if [ "$as_json" -eq 1 ]; then
    emit_json "$state" "$detail" "$cfg" "$actionable" "$(profiles_json)" "$extra"
  else
    printf '%s\n' "$state"
    [ -n "$detail" ]     && printf '  %s\n' "$detail"
    [ -n "$cfg" ]        && printf '  활성 프로파일: %s\n' "$cfg"
    [ -n "$actionable" ] && printf '  다음: %s\n' "$actionable"
    if [ "$state" = "disconnected" ]; then
      local r; r="$(classify_failure "$WATCH_LOG")"
      if [ -n "$r" ]; then
        local reason at summary advice hint raw
        IFS=$'\t' read -r reason at summary advice hint raw <<<"$r"
        printf '  마지막 실패: %s — %s (%s)\n' "$summary" "$advice" "$at"
        printf '    %s\n    %s\n' "$hint" "$raw"
      fi
    fi
    return 0
  fi
}

# ── profiles / use / forget ─────────────────────────────────────────────
cmd_profiles() {
  local as_json="$1"
  if [ "$as_json" -eq 1 ]; then profiles_json; return 0; fi

  local active; active="$(active_name)"
  local n found=0
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    found=1
    if [ "$n" = "$active" ]; then printf '* %s\n' "$n"; else printf '  %s\n' "$n"; fi
  done <<EOF
$(stored_names)
EOF
  [ "$found" -eq 1 ] || echo "보관된 .ovpn 이 없습니다. vpn-ctl import <file>"
}

cmd_use() {
  local name="$1" src
  src="$(stored_path_of "$name")"
  [ -n "$src" ] || { echo "vpn-ctl use: 보관된 프로파일이 아닙니다: $name" >&2; exit 2; }

  # 세션이 살아 있는데 활성을 바꾸면 그 세션은 옛 프로파일 것이다. 끊지는
  # 않는다 (사용자 연결을 말없이 죽이지 않는다) — 알려만 준다.
  if have_backend && backend_ready; then
    local prev; prev="$(active_name)"
    if [ -n "$prev" ] && [ -n "$(session_status_text "$prev")" ]; then
      echo "vpn-ctl use: '$prev' 세션이 아직 살아 있습니다. 끊고 다시 연결하세요." >&2
    fi
  fi

  set_active "$name"
  if have_backend && backend_ready; then
    import_to_backend "$src" "$name" || { echo "vpn-ctl use: openvpn3 등록 실패" >&2; exit 1; }
  fi
  echo "활성 프로파일: $name"
}

cmd_forget() {
  local name="$1" src
  src="$(stored_path_of "$name")"
  [ -n "$src" ] || { echo "vpn-ctl forget: 보관된 프로파일이 아닙니다: $name" >&2; exit 2; }

  # openvpn3 등록과 보관본을 함께 지운다. 한쪽만 남기면 status 의 판단 근거와
  # 실제 상태가 갈린다.
  if have_backend && backend_ready; then with_backend_lock remove_backend_config "$name"; fi
  rm -f "$src"

  # 활성이던 걸 지웠으면 남은 것 중 최신으로 승계한다. 아무것도 안 남으면
  # active 표시도 지워 missing-config 로 돌아간다.
  if [ "$(head -1 "$ACTIVE_FILE" 2>/dev/null)" = "$name" ]; then
    rm -f "$ACTIVE_FILE"
    local next; next="$(stored_names | head -1)"
    [ -n "$next" ] && set_active "$next"
  fi
  echo "삭제: $name"
}

# ── up / down ───────────────────────────────────────────────────────────
# 실제 연결 로직은 vpn-up / vpn-down 이 갖고 있다. 중복 구현하지 않고 위임한다.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

delegate() {
  local script="$1"; shift
  if [ -x "$here/$script" ]; then
    exec "$here/$script" "$@"
  elif command -v "$script" >/dev/null 2>&1; then
    exec "$script" "$@"
  else
    echo "vpn-ctl: $script 를 찾을 수 없습니다" >&2
    exit 127
  fi
}

# exec 하지 않고 실행해 종료코드를 돌려받는다 (뒤처리가 필요한 up 용)
run_script() {
  local script="$1"; shift
  if [ -x "$here/$script" ]; then
    "$here/$script" "$@"
  elif command -v "$script" >/dev/null 2>&1; then
    "$script" "$@"
  else
    echo "vpn-ctl: $script 를 찾을 수 없습니다" >&2
    return 127
  fi
}

# ── import ──────────────────────────────────────────────────────────────
cmd_import() {
  local src="$1" cfg="${2:-}"

  [ -n "$src" ] || { echo "vpn-ctl import: 파일 경로가 필요합니다" >&2; exit 2; }
  [ -f "$src" ] || { echo "vpn-ctl import: 파일이 없습니다: $src" >&2; exit 2; }
  have_backend  || { echo "vpn-ctl import: openvpn3 가 없습니다. 먼저: $(backend_install_cmd)" >&2; exit 1; }

  mkdir -p "$DATA_DIR"
  chmod 700 "$DATA_DIR"

  # 프로파일 이름은 파일명에서 유도한다 — 매직 상수를 두지 않는다.
  # rtst-vpn.ovpn -> "rtst-vpn"
  if [ -z "$cfg" ]; then
    cfg="$(profile_name_of "$src")"
  fi

  # **보관 파일명은 언제나 프로파일 이름과 같아야 한다.**
  # 이름을 따로 받았을 때 원본 파일명 그대로 보관하면 active 마커가
  # 보관본으로 되짚을 수 없는 이름을 가리키게 되고, 그때부터
  #   보관본 = hansulee-hell / openvpn3 = hell / active = hell
  # 처럼 세 갈래로 갈라진다. 그러면 status 는 hansulee-hell 을 보고 "세션
  # 없음" 이라 하는데 실제 세션은 hell 로 살아 있다 — 연결이 됐는데도
  # 첫 화면으로 되돌아가는 것처럼 보인다. (실제로 겪었다.)
  local ext="${src##*.}"
  [ "$ext" = "$src" ] && ext="ovpn"
  local dest="$DATA_DIR/$cfg.$ext"

  # 원본이 이미 그 자리에 있으면 복사하지 않는다 (재등록 경로).
  if [ "$(readlink -f "$src")" != "$(readlink -f "$dest" 2>/dev/null)" ]; then
    install -m 600 "$src" "$dest"
    echo "보관: $dest"
  fi

  import_to_backend "$dest" "$cfg" || exit 1

  # 방금 고른 것을 활성으로 만든다. 사용자가 파일을 고르는 행위 자체가
  # "이걸 쓰겠다" 는 뜻이므로 따로 묻지 않는다.
  set_active "$cfg"
  echo "import 완료: $cfg (활성)"
}

# ── 인자 파싱 ───────────────────────────────────────────────────────────
usage() { sed -n '/^# vpn-ctl —/,/^$/p' "$0" | sed 's/^# \?//'; }

CMD="${1:-status}"; shift || true
JSON=0
WATCH_MODE=""
CONFIG=""
POSITIONAL=()

while [ $# -gt 0 ]; do
  case "$1" in
    --json)    JSON=1 ;;
    --config|--session-path) WATCH_MODE="$1" ;;   # _watch 전용
    -h|--help) usage; exit 0 ;;
    -*)        echo "vpn-ctl: 알 수 없는 옵션: $1" >&2; exit 2 ;;
    *)         POSITIONAL+=("$1") ;;
  esac
  shift
done

case "$CMD" in
  status)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    cmd_status "$CONFIG" "$JSON"
    ;;
  up)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    if [ -z "$CONFIG" ]; then
      # 활성 프로파일이 openvpn3 에 등록돼 있도록 보장한다 — 사라졌으면
      # 보관본으로 조용히 복구하고, 등록된 .ovpn 자체가 없으면 거부한다.
      CONFIG="$(ensure_config)" || {
        echo "vpn-ctl up: 등록된 .ovpn 이 없습니다. 먼저 vpn-ctl import <file>" >&2
        exit 1; }
    fi
    # 세션이 생기면 바로 붙을 감시자를 먼저 띄운다. 세션은 실패하면 흔적
    # 없이 사라지므로, 처음부터 붙어 있어야 원인을 놓치지 않는다.
    clear_watch_record
    spawn_watcher --config "$CONFIG"
    run_script vpn-up "$CONFIG"; rc=$?
    if [ -n "$(session_status_text "$CONFIG")" ]; then
      # vpn-up 이 URL 을 받았으면 서버 인증 단계까지는 간 것이다
      [ "$rc" -eq 0 ] && state_dir && : > "$STATE_DIR/auth-seen"
    else
      # 세션이 없다: 시작도 못 했거나(감시자는 아직 대기 중) 벌써 끝났다
      kill_idle_watcher
    fi
    if [ "$rc" -ne 0 ] && [ -n "$(session_status_text "$CONFIG")" ]; then
      echo "서버가 아직 로그인 페이지를 주지 않았습니다. 잠시 기다리면 연결되거나, 실패 원인이 표시됩니다." >&2
    fi
    exit "$rc"
    ;;
  down)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    [ -n "$CONFIG" ] || CONFIG="$(session_config_or_active)"
    [ -n "$CONFIG" ] || { echo "vpn-ctl down: 등록된 .ovpn 이 없습니다" >&2; exit 1; }
    # 일부러 끊는 건 실패가 아니다 — 이전 실패 기록도 함께 치운다
    clear_watch_record
    kill_idle_watcher
    delegate vpn-down "$CONFIG"
    ;;
  clear-error)
    clear_watch_record
    ;;
  _watch)
    [ ${#POSITIONAL[@]} -ge 1 ] || exit 2
    cmd_watch "$WATCH_MODE" "${POSITIONAL[0]}"
    ;;
  auth-url)
    cmd_auth_url
    ;;
  ensure-config)
    ensure_config >/dev/null && echo "프로파일 준비됨" || { echo "복구 실패" >&2; exit 1; }
    ;;
  profiles)
    cmd_profiles "$JSON"
    ;;
  use)
    [ ${#POSITIONAL[@]} -ge 1 ] || { echo "usage: vpn-ctl use <name>" >&2; exit 2; }
    cmd_use "${POSITIONAL[0]}"
    ;;
  forget)
    [ ${#POSITIONAL[@]} -ge 1 ] || { echo "usage: vpn-ctl forget <name>" >&2; exit 2; }
    cmd_forget "${POSITIONAL[0]}"
    ;;
  import)
    [ ${#POSITIONAL[@]} -ge 1 ] || { echo "usage: vpn-ctl import <file> [config]" >&2; exit 2; }
    [ ${#POSITIONAL[@]} -ge 2 ] && CONFIG="${POSITIONAL[1]}"
    cmd_import "${POSITIONAL[0]}" "$CONFIG"
    ;;
  backend-install-cmd)
    backend_install_cmd
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "vpn-ctl: 알 수 없는 명령: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
