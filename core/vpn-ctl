#!/usr/bin/env bash
# vpn-ctl — VPN 상태·제어의 단일 진입점. UI 레이어가 이것만 호출한다.
#
# Omarchy 에 의존하지 않는다. 평범한 CLI 이므로 우분투·서버에서도 그대로 쓴다.
#
# usage:
#   vpn-ctl status [--json]      상태 조회. 항상 종료코드 0, 상태는 출력으로
#   vpn-ctl up [config]          연결 (SSO URL 브라우저 오픈)
#   vpn-ctl down [config]        끊기 + 좀비 세션 정리
#   vpn-ctl import <file>        .ovpn 을 보관하고 활성으로 지정 + openvpn3 에 import
#                                프로파일 이름은 파일명에서 유도된다
#   vpn-ctl profiles [--json]    보관된 .ovpn 목록 (활성 표시)
#   vpn-ctl use <name>           활성 프로파일 전환
#   vpn-ctl forget <name>        보관본 + openvpn3 프로파일 삭제
#   vpn-ctl auth-url             현재 세션의 SSO 인증 URL 출력 (복사해서 원하는
#                                브라우저에서 열면 그 세션이 연결된다)
#   vpn-ctl ensure-config        프로파일이 없으면 보관된 .ovpn 으로 복구
#                                (status/up 이 자동으로 하므로 보통 직접 쓸 일 없다)
#   vpn-ctl backend-install-cmd  백엔드 설치 명령 문자열을 출력 (실행하지 않음)
#   vpn-ctl -h
#
# 상태 모델 (status --json 의 .state):
#   missing-backend  openvpn3 미설치
#   missing-config   사용자가 .ovpn 을 등록한 적이 없다 — 파일을 골라야 한다
#   backend-busy     openvpn3 서비스 응답 없음 (부팅 직후 등). 연결 상태는 미확정
#   disconnected     준비됐고 미연결
#   authenticating   SSO 인증 대기
#   connected        연결됨
#   error            그 외
#
# 등록 여부의 판단 근거는 **우리 보관본**($DATA_DIR/*.ovpn)이다. openvpn3 의
# configs-list 가 아니다 — 그건 D-Bus 서비스 상태에 따라 비어 보일 수 있고,
# 우리가 넣지 않은 프로파일이 들어 있을 수도 있다. 사용자가 이 플러그인으로
# 고른 파일만이 "등록했다" 의 근거다. openvpn3 쪽 등록은 필요할 때 우리가
# 보관본으로 다시 만들어 주면 되는 파생 상태다.
#
# 검증 상태 (openvpn3 v27.1 실기기):
#   missing-backend / missing-config / disconnected / authenticating 검증됨.
#   import / use / forget / profiles, 활성 승계, 마지막 삭제 → missing-config
#   전이까지 실제로 돌려 확인했다.
#   connected 는 SSO 로그인을 끝까지 하지 않아 미검증 —
#   sessions-list 의 'Client connected' 문자열 대조에 의존한다.

set -uo pipefail

DATA_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rtst-vpn"

# ── 유틸 ────────────────────────────────────────────────────────────────
json_escape() {
  # 따옴표·백슬래시·개행만 처리하면 우리 문자열에는 충분하다
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' '
}

emit_json() {
  # emit_json <state> <detail> <config> <actionable> <profiles-json>
  printf '{"state":"%s","detail":"%s","config":"%s","actionable":%s,"profiles":%s}\n' \
    "$(json_escape "$1")" "$(json_escape "$2")" "$(json_escape "$3")" \
    "$([ -n "${4:-}" ] && printf '"%s"' "$(json_escape "$4")" || printf 'null')" \
    "${5:-[]}"
}

have_backend() { command -v openvpn3 >/dev/null 2>&1; }

backend_install_cmd() {
  # Arch/Omarchy: openvpn3 는 공식 저장소에 없고 AUR 에 있다.
  if command -v omarchy >/dev/null 2>&1; then
    printf 'omarchy pkg aur add openvpn3\n'
  elif command -v yay >/dev/null 2>&1; then
    printf 'yay -S --needed openvpn3\n'
  elif command -v apt >/dev/null 2>&1; then
    printf '# Debian/Ubuntu: openvpn3 저장소 등록이 필요하다. docs/ 참조\n'
  else
    printf '# openvpn3 를 배포판 방식으로 설치할 것\n'
  fi
}

# import 된 프로파일 이름을 전부 나열한다.
# configs-list 출력 형식 (v27.1 실측):
#   Configuration Name                     Last used
#   ------------------------------------------------
#   hell                                   2026-08-27 15:25:31
#   ------------------------------------------------
# openvpn3 configs-list 원문을 캐시한다 (한 번만 호출).
CONFIGS_RAW=""
CONFIGS_OK=0
configs_load() {
  [ -n "$CONFIGS_RAW" ] && return 0
  CONFIGS_RAW="$(openvpn3 configs-list 2>/dev/null)"
  # 표 헤더가 있으면 openvpn3 가 실제로 응답한 것이다. 없으면 조회 실패로 본다 —
  # configmgr 은 D-Bus on-demand 서비스라 부팅 직후엔 활성화 전일 수 있다.
  # "빈 목록" 과 "물어볼 수 없었음" 을 절대 같게 취급하지 않는다.
  if printf '%s' "$CONFIGS_RAW" | grep -q 'Configuration Name'; then
    CONFIGS_OK=1
  else
    CONFIGS_OK=0
  fi
}

backend_ready() { configs_load; [ "$CONFIGS_OK" -eq 1 ]; }

configs_list_names() {
  configs_load
  [ "$CONFIGS_OK" -eq 1 ] || return 0
  printf '%s\n' "$CONFIGS_RAW" | awk '
    /^-+$/                    { next }
    /^Configuration Name/     { next }
    NF == 0                   { next }
    { print $1 }
  '
}

# ── 보관소 ($DATA_DIR) ──────────────────────────────────────────────────
# 사용자가 고른 .ovpn 원본을 여기에 보관한다. 이게 "등록했다" 의 유일한 근거다.
#
#   $DATA_DIR/<name>.ovpn   보관된 프로파일 (여러 개 가능)
#   $DATA_DIR/active        활성 프로파일 이름 한 줄
#
# openvpn3 쪽 등록은 여기서 언제든 다시 만들 수 있는 파생 상태로 취급한다.
ACTIVE_FILE="$DATA_DIR/active"

profile_name_of() {
  # /path/to/hansulee-hell.ovpn -> hansulee-hell
  local b; b="$(basename "$1")"
  printf '%s\n' "${b%.*}"
}

# 보관된 파일 경로를 최신순으로 나열한다.
stored_paths() {
  ls -1t "$DATA_DIR"/*.ovpn "$DATA_DIR"/*.conf 2>/dev/null
}

stored_names() {
  local p
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    profile_name_of "$p"
  done <<EOF
$(stored_paths)
EOF
}

stored_path_of() {
  local want="$1" p
  [ -n "$want" ] || return 0
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    [ "$(profile_name_of "$p")" = "$want" ] && { printf '%s\n' "$p"; return 0; }
  done <<EOF
$(stored_paths)
EOF
  return 0
}

set_active() {
  mkdir -p "$DATA_DIR"; chmod 700 "$DATA_DIR"
  printf '%s\n' "$1" > "$ACTIVE_FILE"
  chmod 600 "$ACTIVE_FILE"
}

# 활성 프로파일 이름. active 파일이 가리키는 게 실제로 보관돼 있어야 인정한다.
# 없거나 어긋나면 가장 최근에 넣은 것으로 승계한다 — active 파일이 생기기
# 전에 import 한 사용자도 그대로 동작해야 하므로.
active_name() {
  local name
  name="$(head -1 "$ACTIVE_FILE" 2>/dev/null)"
  if [ -n "$name" ] && [ -n "$(stored_path_of "$name")" ]; then
    printf '%s\n' "$name"; return 0
  fi
  stored_names | head -1
}

# 같은 이름의 openvpn3 프로파일을 지운다. openvpn3 는 이름 중복을 막지 않아서,
# 이걸 안 하면 다시 넣을 때마다 쌓이고 configs-list 첫 줄이 뭔지 예측 불가가 된다.
remove_backend_config() {
  local cfg="$1"
  while configs_list_names | grep -qxF "$cfg"; do
    openvpn3 config-remove --config "$cfg" --force >/dev/null 2>&1 || break
    CONFIGS_RAW=""; CONFIGS_OK=0
  done
}

# 보관본을 openvpn3 에 등록한다. --persistent: 재부팅 후에도 유지.
import_to_backend() {
  local src="$1" cfg="$2"
  remove_backend_config "$cfg"
  openvpn3 config-import --config "$src" --persistent --name "$cfg" >/dev/null || return 1
  CONFIGS_RAW=""; CONFIGS_OK=0
}

# 활성 프로파일이 openvpn3 에 등록돼 있도록 보장하고 그 이름을 출력한다.
# 등록된 .ovpn 자체가 없으면 실패한다 (= missing-config).
ensure_config() {
  local cfg; cfg="$(active_name)"
  [ -n "$cfg" ] || return 1

  backend_ready || { echo "vpn-ctl: openvpn3 응답 없음 (잠시 후 재시도)" >&2; return 1; }
  config_imported "$cfg" && { printf '%s\n' "$cfg"; return 0; }

  local src; src="$(stored_path_of "$cfg")"
  [ -n "$src" ] || return 1
  echo "vpn-ctl: openvpn3 에 프로파일이 없어 보관본으로 복구합니다: $(basename "$src")" >&2
  import_to_backend "$src" "$cfg" || return 1
  printf '%s\n' "$cfg"
}

# 보관 목록을 JSON 배열로. UI 가 프로파일 관리 화면을 그리는 근거.
profiles_json() {
  local active; active="$(active_name)"
  local out="[" first=1 p n
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    n="$(profile_name_of "$p")"
    [ "$first" -eq 1 ] || out="$out,"
    first=0
    out="$out{\"name\":\"$(json_escape "$n")\",\"file\":\"$(json_escape "$(basename "$p")")\""
    if [ "$n" = "$active" ]; then out="$out,\"active\":true}"; else out="$out,\"active\":false}"; fi
  done <<EOF
$(stored_paths)
EOF
  printf '%s]\n' "$out"
}

config_imported() {
  local cfg="$1"
  [ -n "$cfg" ] || return 1
  configs_list_names | grep -qxF "$cfg"
}

# sessions-list 에서 해당 config 의 Status 줄을 뽑는다.
# 출력 형식(기존 vpn-up/vpn-down awk 기준):
#   Path: /net/openvpn/v3/sessions/...
#    Config name: <name>
#    Status: <text>
session_status_text() {
  local cfg="$1"
  openvpn3 sessions-list 2>/dev/null | awk -v cfg="$cfg" '
    /^ *Path:/         { path=$2 }
    /^ *Config name:/  { name=$3 }
    /^ *Status:/ {
      if (name==cfg) { sub(/^ *Status: */, ""); print; exit }
    }
  '
}

# ── auth-url ────────────────────────────────────────────────────────────
# 현재 세션의 SSO 인증 URL 을 출력한다.
#
# openvpn3 는 이 URL 을 XDG Desktop Portal 로 넘겨 **시스템 기본 브라우저**에
# 띄운다. 그걸 바꿀 방법이 없다 ($BROWSER 무시, xdg-open 미호출, 끄는 옵션 없음).
# 다른 브라우저에서 인증하려면 이 URL 을 복사해 직접 열면 된다 —
# URL 은 세션에 묶여 있으므로 어디서 로그인하든 그 세션이 연결된다.
cmd_auth_url() {
  have_backend || { echo "vpn-ctl auth-url: openvpn3 가 없습니다" >&2; return 1; }
  local url
  url=$(openvpn3 session-auth 2>/dev/null \
        | awk -F': ' '/^ *Auth URL:/ {sub(/^ +/, "", $2); print $2; exit}')
  [ -n "$url" ] || { echo "vpn-ctl auth-url: 인증 대기 중인 세션이 없습니다" >&2; return 1; }
  printf '%s\n' "$url"
}

# ── status ──────────────────────────────────────────────────────────────
cmd_status() {
  local want="$1" as_json="$2"
  local state detail actionable="" cfg=""

  if ! have_backend; then
    state="missing-backend"
    detail="openvpn3 가 설치되지 않았습니다"
    actionable="$(backend_install_cmd)"
    emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json"
    return 0
  fi

  # 등록 여부를 **먼저** 본다. 근거가 우리 보관소이므로 openvpn3 가 응답하지
  # 않아도 확정할 수 있다. "아직 아무것도 고르지 않았다" 는 백엔드 사정과
  # 무관한 사실이고, UI 는 이걸 알아야 연결 버튼을 잠글 수 있다.
  cfg="$(active_name)"
  if [ -n "$want" ] && [ -n "$(stored_path_of "$want")" ]; then cfg="$want"; fi

  if [ -z "$cfg" ]; then
    state="missing-config"
    detail="등록된 .ovpn 이 없습니다"
    emit_or_print "$state" "$detail" "" "$actionable" "$as_json"
    return 0
  fi

  if ! backend_ready; then
    # openvpn3 에 물어보지 못한 상태. 연결 여부는 모르지만 프로파일은 있다.
    state="backend-busy"
    detail="openvpn3 서비스 응답 대기 중"
    emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json"
    return 0
  fi

  # openvpn3 쪽 등록이 사라졌으면 **조용히 복원한다.**
  # 사용자는 이미 파일을 골랐다. 그 결정을 다시 묻지 않는다 — openvpn3
  # 프로파일은 D-Bus 서비스 상태에 따라 사라질 수 있지만, 우리가 원본을
  # 들고 있으므로 그건 사용자가 알 필요 없는 내부 사정이다.
  if ! config_imported "$cfg"; then
    ensure_config >/dev/null 2>&1
    CONFIGS_RAW=""; CONFIGS_OK=0   # 다시 넣었으니 목록 캐시를 버린다
  fi

  if ! config_imported "$cfg"; then
    state="error"
    detail="프로파일 '$cfg' 을 openvpn3 에 등록할 수 없습니다"
  else
    local st
    st="$(session_status_text "$cfg")"
    if [ -z "$st" ]; then
      state="disconnected"
      detail="세션 없음"
    elif printf '%s' "$st" | grep -q 'Client connected'; then
      state="connected"
      detail="$st"
    elif printf '%s' "$st" | grep -qiE 'auth|web based'; then
      state="authenticating"
      detail="$st"
    else
      state="error"
      detail="$st"
    fi
  fi

  emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json"
  return 0
}

emit_or_print() {
  local state="$1" detail="$2" cfg="$3" actionable="$4" as_json="$5"
  if [ "$as_json" -eq 1 ]; then
    emit_json "$state" "$detail" "$cfg" "$actionable" "$(profiles_json)"
  else
    printf '%s\n' "$state"
    [ -n "$detail" ]     && printf '  %s\n' "$detail"
    [ -n "$cfg" ]        && printf '  활성 프로파일: %s\n' "$cfg"
    [ -n "$actionable" ] && printf '  다음: %s\n' "$actionable"
    return 0
  fi
}

# ── profiles / use / forget ─────────────────────────────────────────────
cmd_profiles() {
  local as_json="$1"
  if [ "$as_json" -eq 1 ]; then profiles_json; return 0; fi

  local active; active="$(active_name)"
  local n found=0
  while IFS= read -r n; do
    [ -n "$n" ] || continue
    found=1
    if [ "$n" = "$active" ]; then printf '* %s\n' "$n"; else printf '  %s\n' "$n"; fi
  done <<EOF
$(stored_names)
EOF
  [ "$found" -eq 1 ] || echo "보관된 .ovpn 이 없습니다. vpn-ctl import <file>"
}

cmd_use() {
  local name="$1" src
  src="$(stored_path_of "$name")"
  [ -n "$src" ] || { echo "vpn-ctl use: 보관된 프로파일이 아닙니다: $name" >&2; exit 2; }

  # 세션이 살아 있는데 활성을 바꾸면 그 세션은 옛 프로파일 것이다. 끊지는
  # 않는다 (사용자 연결을 말없이 죽이지 않는다) — 알려만 준다.
  if have_backend && backend_ready; then
    local prev; prev="$(active_name)"
    if [ -n "$prev" ] && [ -n "$(session_status_text "$prev")" ]; then
      echo "vpn-ctl use: '$prev' 세션이 아직 살아 있습니다. 끊고 다시 연결하세요." >&2
    fi
  fi

  set_active "$name"
  if have_backend && backend_ready; then
    import_to_backend "$src" "$name" || { echo "vpn-ctl use: openvpn3 등록 실패" >&2; exit 1; }
  fi
  echo "활성 프로파일: $name"
}

cmd_forget() {
  local name="$1" src
  src="$(stored_path_of "$name")"
  [ -n "$src" ] || { echo "vpn-ctl forget: 보관된 프로파일이 아닙니다: $name" >&2; exit 2; }

  # openvpn3 등록과 보관본을 함께 지운다. 한쪽만 남기면 status 의 판단 근거와
  # 실제 상태가 갈린다.
  if have_backend && backend_ready; then remove_backend_config "$name"; fi
  rm -f "$src"

  # 활성이던 걸 지웠으면 남은 것 중 최신으로 승계한다. 아무것도 안 남으면
  # active 표시도 지워 missing-config 로 돌아간다.
  if [ "$(head -1 "$ACTIVE_FILE" 2>/dev/null)" = "$name" ]; then
    rm -f "$ACTIVE_FILE"
    local next; next="$(stored_names | head -1)"
    [ -n "$next" ] && set_active "$next"
  fi
  echo "삭제: $name"
}

# ── up / down ───────────────────────────────────────────────────────────
# 실제 연결 로직은 vpn-up / vpn-down 이 갖고 있다. 중복 구현하지 않고 위임한다.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

delegate() {
  local script="$1"; shift
  if [ -x "$here/$script" ]; then
    exec "$here/$script" "$@"
  elif command -v "$script" >/dev/null 2>&1; then
    exec "$script" "$@"
  else
    echo "vpn-ctl: $script 를 찾을 수 없습니다" >&2
    exit 127
  fi
}

# ── import ──────────────────────────────────────────────────────────────
cmd_import() {
  local src="$1" cfg="${2:-}"

  [ -n "$src" ] || { echo "vpn-ctl import: 파일 경로가 필요합니다" >&2; exit 2; }
  [ -f "$src" ] || { echo "vpn-ctl import: 파일이 없습니다: $src" >&2; exit 2; }
  have_backend  || { echo "vpn-ctl import: openvpn3 가 없습니다. 먼저: $(backend_install_cmd)" >&2; exit 1; }

  mkdir -p "$DATA_DIR"
  chmod 700 "$DATA_DIR"

  local dest="$DATA_DIR/$(basename "$src")"
  # 원본이 이미 보관소 안의 파일이면 복사하지 않는다 (use/재등록 경로).
  if [ "$(readlink -f "$src")" != "$(readlink -f "$dest" 2>/dev/null)" ]; then
    install -m 600 "$src" "$dest"
    echo "보관: $dest"
  fi

  # 프로파일 이름은 파일명에서 유도한다 — 매직 상수를 두지 않는다.
  # rtst-vpn.ovpn -> "rtst-vpn"
  if [ -z "$cfg" ]; then
    cfg="$(profile_name_of "$src")"
  fi

  import_to_backend "$dest" "$cfg" || exit 1

  # 방금 고른 것을 활성으로 만든다. 사용자가 파일을 고르는 행위 자체가
  # "이걸 쓰겠다" 는 뜻이므로 따로 묻지 않는다.
  set_active "$cfg"
  echo "import 완료: $cfg (활성)"
}

# ── 인자 파싱 ───────────────────────────────────────────────────────────
usage() { sed -n '/^# vpn-ctl —/,/^$/p' "$0" | sed 's/^# \?//'; }

CMD="${1:-status}"; shift || true
JSON=0
CONFIG=""
POSITIONAL=()

while [ $# -gt 0 ]; do
  case "$1" in
    --json)    JSON=1 ;;
    -h|--help) usage; exit 0 ;;
    -*)        echo "vpn-ctl: 알 수 없는 옵션: $1" >&2; exit 2 ;;
    *)         POSITIONAL+=("$1") ;;
  esac
  shift
done

case "$CMD" in
  status)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    cmd_status "$CONFIG" "$JSON"
    ;;
  up)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    if [ -z "$CONFIG" ]; then
      # 활성 프로파일이 openvpn3 에 등록돼 있도록 보장한다 — 사라졌으면
      # 보관본으로 조용히 복구하고, 등록된 .ovpn 자체가 없으면 거부한다.
      CONFIG="$(ensure_config)" || {
        echo "vpn-ctl up: 등록된 .ovpn 이 없습니다. 먼저 vpn-ctl import <file>" >&2
        exit 1; }
    fi
    delegate vpn-up "$CONFIG"
    ;;
  down)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    [ -n "$CONFIG" ] || CONFIG="$(active_name)"
    [ -n "$CONFIG" ] || { echo "vpn-ctl down: 등록된 .ovpn 이 없습니다" >&2; exit 1; }
    delegate vpn-down "$CONFIG"
    ;;
  auth-url)
    cmd_auth_url
    ;;
  ensure-config)
    ensure_config >/dev/null && echo "프로파일 준비됨" || { echo "복구 실패" >&2; exit 1; }
    ;;
  profiles)
    cmd_profiles "$JSON"
    ;;
  use)
    [ ${#POSITIONAL[@]} -ge 1 ] || { echo "usage: vpn-ctl use <name>" >&2; exit 2; }
    cmd_use "${POSITIONAL[0]}"
    ;;
  forget)
    [ ${#POSITIONAL[@]} -ge 1 ] || { echo "usage: vpn-ctl forget <name>" >&2; exit 2; }
    cmd_forget "${POSITIONAL[0]}"
    ;;
  import)
    [ ${#POSITIONAL[@]} -ge 1 ] || { echo "usage: vpn-ctl import <file> [config]" >&2; exit 2; }
    [ ${#POSITIONAL[@]} -ge 2 ] && CONFIG="${POSITIONAL[1]}"
    cmd_import "${POSITIONAL[0]}" "$CONFIG"
    ;;
  backend-install-cmd)
    backend_install_cmd
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "vpn-ctl: 알 수 없는 명령: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
