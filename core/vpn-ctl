#!/usr/bin/env bash
# vpn-ctl — VPN 상태·제어의 단일 진입점. UI 레이어가 이것만 호출한다.
#
# Omarchy 에 의존하지 않는다. 평범한 CLI 이므로 우분투·서버에서도 그대로 쓴다.
#
# usage:
#   vpn-ctl status [--json]      상태 조회. 항상 종료코드 0, 상태는 출력으로
#   vpn-ctl up [config]          연결 (SSO URL 브라우저 오픈)
#   vpn-ctl down [config]        끊기 + 좀비 세션 정리
#   vpn-ctl import <file>        .ovpn 을 데이터 디렉터리에 보관하고 openvpn3 에 import
#                                프로파일 이름은 파일명에서 유도된다
#   vpn-ctl auth-url             현재 세션의 SSO 인증 URL 출력 (복사해서 원하는
#                                브라우저에서 열면 그 세션이 연결된다)
#   vpn-ctl backend-install-cmd  백엔드 설치 명령 문자열을 출력 (실행하지 않음)
#   vpn-ctl -h
#
# 상태 모델 (status --json 의 .state):
#   missing-backend  openvpn3 미설치
#   missing-config   설치됐으나 프로파일 미 import
#   disconnected     준비됐고 미연결
#   authenticating   SSO 인증 대기
#   connected        연결됨
#   error            그 외
#
# 검증 상태: missing-backend / missing-config 는 실기기 검증됨.
#   sessions-list 파싱(연결 상태 판별)은 기존 vpn-up/vpn-down 의 awk 에
#   인코딩된 출력 형식을 근거로 작성했으며 아직 실제 세션으로 대조하지 못했다.

set -uo pipefail

DATA_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rtst-vpn"

# ── 유틸 ────────────────────────────────────────────────────────────────
json_escape() {
  # 따옴표·백슬래시·개행만 처리하면 우리 문자열에는 충분하다
  printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' | tr '\n' ' '
}

emit_json() {
  # emit_json <state> <detail> <config> <actionable>
  printf '{"state":"%s","detail":"%s","config":"%s","actionable":%s}\n' \
    "$(json_escape "$1")" "$(json_escape "$2")" "$(json_escape "$3")" \
    "$([ -n "${4:-}" ] && printf '"%s"' "$(json_escape "$4")" || printf 'null')"
}

have_backend() { command -v openvpn3 >/dev/null 2>&1; }

backend_install_cmd() {
  # Arch/Omarchy: openvpn3 는 공식 저장소에 없고 AUR 에 있다.
  if command -v omarchy >/dev/null 2>&1; then
    printf 'omarchy pkg aur add openvpn3\n'
  elif command -v yay >/dev/null 2>&1; then
    printf 'yay -S --needed openvpn3\n'
  elif command -v apt >/dev/null 2>&1; then
    printf '# Debian/Ubuntu: openvpn3 저장소 등록이 필요하다. docs/ 참조\n'
  else
    printf '# openvpn3 를 배포판 방식으로 설치할 것\n'
  fi
}

# import 된 프로파일 이름을 전부 나열한다.
# configs-list 출력 형식 (v27.1 실측):
#   Configuration Name                     Last used
#   ------------------------------------------------
#   hell                                   2026-08-27 15:25:31
#   ------------------------------------------------
configs_list_names() {
  openvpn3 configs-list 2>/dev/null | awk '
    /^-+$/                    { next }
    /^Configuration Name/     { next }
    /^No configuration/       { next }
    NF == 0                   { next }
    { print $1 }
  '
}

# 프로파일 이름을 결정한다. 인자로 주면 그것, 없으면 import 된 첫 번째.
# 매직 상수를 두지 않기 위해 openvpn3 에 등록된 것에서 발견한다.
resolve_config() {
  local want="${1:-}"
  if [ -n "$want" ]; then printf '%s\n' "$want"; return 0; fi
  configs_list_names | head -1
}

config_imported() {
  local cfg="$1"
  [ -n "$cfg" ] || return 1
  configs_list_names | grep -qxF "$cfg"
}

# sessions-list 에서 해당 config 의 Status 줄을 뽑는다.
# 출력 형식(기존 vpn-up/vpn-down awk 기준):
#   Path: /net/openvpn/v3/sessions/...
#    Config name: <name>
#    Status: <text>
session_status_text() {
  local cfg="$1"
  openvpn3 sessions-list 2>/dev/null | awk -v cfg="$cfg" '
    /^ *Path:/         { path=$2 }
    /^ *Config name:/  { name=$3 }
    /^ *Status:/ {
      if (name==cfg) { sub(/^ *Status: */, ""); print; exit }
    }
  '
}

# ── auth-url ────────────────────────────────────────────────────────────
# 현재 세션의 SSO 인증 URL 을 출력한다.
#
# openvpn3 는 이 URL 을 XDG Desktop Portal 로 넘겨 **시스템 기본 브라우저**에
# 띄운다. 그걸 바꿀 방법이 없다 ($BROWSER 무시, xdg-open 미호출, 끄는 옵션 없음).
# 다른 브라우저에서 인증하려면 이 URL 을 복사해 직접 열면 된다 —
# URL 은 세션에 묶여 있으므로 어디서 로그인하든 그 세션이 연결된다.
cmd_auth_url() {
  have_backend || { echo "vpn-ctl auth-url: openvpn3 가 없습니다" >&2; return 1; }
  local url
  url=$(openvpn3 session-auth 2>/dev/null \
        | awk -F': ' '/^ *Auth URL:/ {sub(/^ +/, "", $2); print $2; exit}')
  [ -n "$url" ] || { echo "vpn-ctl auth-url: 인증 대기 중인 세션이 없습니다" >&2; return 1; }
  printf '%s\n' "$url"
}

# ── status ──────────────────────────────────────────────────────────────
cmd_status() {
  local want="$1" as_json="$2"
  local state detail actionable="" cfg=""

  if ! have_backend; then
    state="missing-backend"
    detail="openvpn3 가 설치되지 않았습니다"
    actionable="$(backend_install_cmd)"
    emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json"
    return 0
  fi

  cfg="$(resolve_config "$want")"

  if ! config_imported "$cfg"; then
    state="missing-config"
    detail="VPN 프로파일이 등록되지 않았습니다"
    actionable=""
  else
    local st
    st="$(session_status_text "$cfg")"
    if [ -z "$st" ]; then
      state="disconnected"
      detail="세션 없음"
    elif printf '%s' "$st" | grep -q 'Client connected'; then
      state="connected"
      detail="$st"
    elif printf '%s' "$st" | grep -qiE 'auth|web based'; then
      state="authenticating"
      detail="$st"
    else
      state="error"
      detail="$st"
    fi
  fi

  emit_or_print "$state" "$detail" "$cfg" "$actionable" "$as_json"
  return 0
}

emit_or_print() {
  local state="$1" detail="$2" cfg="$3" actionable="$4" as_json="$5"
  if [ "$as_json" -eq 1 ]; then
    emit_json "$state" "$detail" "$cfg" "$actionable"
  else
    printf '%s\n' "$state"
    [ -n "$detail" ]     && printf '  %s\n' "$detail"
    [ -n "$cfg" ]        && printf '  프로파일: %s\n' "$cfg"
    [ -n "$actionable" ] && printf '  다음: %s\n' "$actionable"
  fi
}

# ── up / down ───────────────────────────────────────────────────────────
# 실제 연결 로직은 vpn-up / vpn-down 이 갖고 있다. 중복 구현하지 않고 위임한다.
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

delegate() {
  local script="$1"; shift
  if [ -x "$here/$script" ]; then
    exec "$here/$script" "$@"
  elif command -v "$script" >/dev/null 2>&1; then
    exec "$script" "$@"
  else
    echo "vpn-ctl: $script 를 찾을 수 없습니다" >&2
    exit 127
  fi
}

# ── import ──────────────────────────────────────────────────────────────
cmd_import() {
  local src="$1" cfg="${2:-}"

  [ -n "$src" ] || { echo "vpn-ctl import: 파일 경로가 필요합니다" >&2; exit 2; }
  [ -f "$src" ] || { echo "vpn-ctl import: 파일이 없습니다: $src" >&2; exit 2; }
  have_backend  || { echo "vpn-ctl import: openvpn3 가 없습니다. 먼저: $(backend_install_cmd)" >&2; exit 1; }

  mkdir -p "$DATA_DIR"
  chmod 700 "$DATA_DIR"

  local dest="$DATA_DIR/$(basename "$src")"
  if [ "$(readlink -f "$src")" != "$(readlink -f "$dest" 2>/dev/null)" ]; then
    install -m 600 "$src" "$dest"
    echo "보관: $dest"
  fi

  # 프로파일 이름은 파일명에서 유도한다 — 매직 상수를 두지 않는다.
  # rtst-vpn.ovpn -> "rtst-vpn"
  if [ -z "$cfg" ]; then
    cfg="$(basename "$src")"
    cfg="${cfg%.*}"
  fi

  # --persistent: 재부팅 후에도 프로파일 유지
  openvpn3 config-import --config "$dest" --persistent --name "$cfg" || exit 1
  echo "import 완료: $cfg"
  openvpn3 configs-list 2>/dev/null | sed -n '1,20p'
}

# ── 인자 파싱 ───────────────────────────────────────────────────────────
usage() { sed -n '/^# vpn-ctl —/,/^$/p' "$0" | sed 's/^# \?//'; }

CMD="${1:-status}"; shift || true
JSON=0
CONFIG=""
POSITIONAL=()

while [ $# -gt 0 ]; do
  case "$1" in
    --json)    JSON=1 ;;
    -h|--help) usage; exit 0 ;;
    -*)        echo "vpn-ctl: 알 수 없는 옵션: $1" >&2; exit 2 ;;
    *)         POSITIONAL+=("$1") ;;
  esac
  shift
done

case "$CMD" in
  status)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    cmd_status "$CONFIG" "$JSON"
    ;;
  up)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    CONFIG="$(resolve_config "$CONFIG")"
    [ -n "$CONFIG" ] || { echo "vpn-ctl up: import 된 프로파일이 없습니다" >&2; exit 1; }
    delegate vpn-up "$CONFIG"
    ;;
  down)
    [ ${#POSITIONAL[@]} -gt 0 ] && CONFIG="${POSITIONAL[0]}"
    CONFIG="$(resolve_config "$CONFIG")"
    [ -n "$CONFIG" ] || { echo "vpn-ctl down: import 된 프로파일이 없습니다" >&2; exit 1; }
    delegate vpn-down "$CONFIG"
    ;;
  auth-url)
    cmd_auth_url
    ;;
  import)
    [ ${#POSITIONAL[@]} -ge 1 ] || { echo "usage: vpn-ctl import <file> [config]" >&2; exit 2; }
    [ ${#POSITIONAL[@]} -ge 2 ] && CONFIG="${POSITIONAL[1]}"
    cmd_import "${POSITIONAL[0]}" "$CONFIG"
    ;;
  backend-install-cmd)
    backend_install_cmd
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "vpn-ctl: 알 수 없는 명령: $CMD" >&2
    usage >&2
    exit 2
    ;;
esac
